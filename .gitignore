# 1. Ignore everything in the repository root by default
*

# 2. Track essential root source files
!*.py
!README.md
!.gitignore

# Track maintained root documentation and project inventory
!MIDI_*.md
!ACTIVE_PROJECT_FILES.txt

# Track the maintained PowerShell test-material runner
!run_all_test_materials.ps1

# 3. Re-include the tests directory and Python tests inside it
!tests/
!tests/**/*.py

# 4. Explicit safety exclusions
Tokens And APIs.txt
env/
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/

